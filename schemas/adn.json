{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://3webobs.com/schemas/adn.json",
  "title": "adn.json",
  "description": "Minimal structural schema for adn.json, published by 3webs (AIVENTURE S.R.L.). Describes the top-level shape actually present in the live file; nested object internals are intentionally left permissive (additionalProperties: true) rather than over-specified.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "node_role": {
      "type": "string"
    },
    "network_name": {
      "type": "string"
    },
    "belongs_to_network": {
      "type": "string"
    },
    "root_domain": {
      "type": "string"
    },
    "technology_partner": {
      "type": "object"
    },
    "platform_identity": {
      "type": "object"
    },
    "node_function": {
      "type": "object"
    },
    "relationship_model": {
      "type": "object"
    },
    "a2a_interface": {
      "type": "object"
    },
    "signal_layer": {
      "type": "object"
    },
    "governance": {
      "type": "object"
    },
    "trust_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "self_declaration": {
      "type": "object"
    },
    "last_updated": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "domain",
    "node_role",
    "network_name",
    "belongs_to_network",
    "root_domain",
    "technology_partner",
    "platform_identity",
    "node_function",
    "relationship_model",
    "a2a_interface",
    "signal_layer",
    "governance",
    "trust_signals",
    "self_declaration",
    "last_updated"
  ],
  "additionalProperties": true
}
