/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://gdpr.aiventure.ro; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://gdpr.aiventure.ro; font-src 'self' data:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

/*.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# Access-Control-Allow-Origin este deja setat de regula /*.json de mai sus.
# Repetat aici, Cloudflare Pages concateneaza cele doua valori si serveste
# "Access-Control-Allow-Origin: *, *", care nu e un header CORS valid si e
# respins de clientii stricti — exact agentii pentru care exista fisierul.
/.well-known/agent-card.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300
